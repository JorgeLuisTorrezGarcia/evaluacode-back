# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# FILE UPLOAD LIMITS
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"

# LOGGING
LOG_LEVEL=info
LOG_FILE_PATH="./logs/app.log"