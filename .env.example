# SERVER CONFIGURATION
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/evaluacode?schema=public"

# CLOUDINARY (Free Tier - 25 créditos mensuales)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# AI SERVICES
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here_optional"

# JWT AUTHENTICATION
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour_RSA_private_key_here\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour_RSA_public_key_here\n-----END PUBLIC KEY-----"
JWT_REFRESH_SECRET="your_very_long_random_refresh_secret_here_minimum_32_chars"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# REDIS CACHE & QUEUE
REDIS_URL="redis://localhost:6379"

# JUDGE0 CODE EVALUATION (Optional - Community Edition)
JUDGE0_API_URL="http://localhost:2358"
JUDGE0_API_KEY="your_judge0_api_key_if_needed"

# FASTAPI AI ENGINE SERVICE
AI_ENGINE_URL="http://localhost:8000"

# CORS ORIGINS (comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# FILE UPLOAD LIMITS
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"

# LOGGING
LOG_LEVEL="info"
LOG_FILE_PATH="./logs/app.log"
