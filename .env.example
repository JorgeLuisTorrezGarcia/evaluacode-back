NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/evaluacode?sslmode=disable"

CLOUDINARY_URL=

# AI SERVICES
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=


# JWT AUTHENTICATION
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REFRESH_SECRET="a6f8c2e4b9d7e3f1a2c5b8e9f2a6d3c7e1f4a8b5c9f2e6a3d8c1f5b2e9a4d7c6f1"
